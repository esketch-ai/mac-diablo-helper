<UserControl x:Class="DM_Helper.Wpf.Controls.SkillRowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:DM_Helper.Wpf.Controls">
    <!--
        One skill slot: special-key link checkbox, bound key, spam/hold mode, interval.

        Hold mode hides the delay box because a held skill has no repeat interval - leaving
        an editable-but-ignored field there is a classic source of "why isn't my setting
        doing anything" confusion.
    -->
    <Grid Margin="0,2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <CheckBox Grid.Column="0" x:Name="CheckBox" HorizontalAlignment="Center"
                  IsChecked="True" Checked="OnChanged" Unchecked="OnChanged" />

        <ctrl:KeyCaptureBox Grid.Column="1" x:Name="KeyBox" MinWidth="86"
                            InputKeyChanged="OnKeyChanged" />

        <ComboBox Grid.Column="2" x:Name="ModeBox" Margin="6,0,0,0" Width="86"
                  SelectionChanged="OnChanged" />

        <TextBox Grid.Column="3" x:Name="DelayBox" Width="56" Margin="6,0,0,0"
                 TextChanged="OnChanged" />

        <TextBlock Grid.Column="4" x:Name="UnitLabel" Text="ms" Margin="4,0,0,0"
                   Foreground="{StaticResource SubtleTextBrush}" />
    </Grid>
</UserControl>
