<UserControl x:Class="DM_Helper.Wpf.Controls.KeyCaptureBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             Cursor="Hand">

    <!--
        Click to capture a key, wheel notch, or mouse button. Esc or Delete clears.

        Windows counterpart of D3KeyTextField.m. Two capture paths are wired up
        deliberately, matching the macOS behaviour: a local WPF handler so binding works
        even without the global hook, plus the low-level hook so side buttons and mouse
        buttons can be picked up while the pointer is over the game window.

        Left click is deliberately NOT captured as a binding - it would be swallowed as a UI
        click and make the field impossible to operate.
    -->

    <Style TargetType="{x:Type UserControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type UserControl}">
                    <Border x:Name="Bd"
                            Background="{StaticResource KeyFieldBgBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="6,4"
                            MinWidth="72"
                            SnapsToDevicePixels="True">
                        <TextBlock x:Name="Label"
                                   Text="{TemplateBinding Tag}"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="{StaticResource SmallFontSize}"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="">
                            <Setter TargetName="Label" Property="Foreground"
                                    Value="{StaticResource SubtleTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            <Setter TargetName="Label" Property="Foreground"
                                    Value="{StaticResource CaptureTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</UserControl>
