<Window x:Class="DM_Helper.Wpf.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DM_Helper 사용 가이드" Height="680" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBgBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock x:Name="HeaderText" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center" />
            <ComboBox x:Name="CategoryCombo" Width="220" SelectionChanged="OnCategoryChanged" />
            <ComboBox x:Name="LangCombo" Width="96" Margin="10,0,0,0" SelectionChanged="OnLangChanged" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="4" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="BodyText" TextWrapping="Wrap" LineHeight="20"
                           Foreground="{StaticResource TextBrush}" />
            </ScrollViewer>
        </Border>

        <Button Grid.Row="2" Content="닫기" Style="{StaticResource SecondaryButton}"
                HorizontalAlignment="Right" Margin="0,10,0,0" Click="OnCloseClick" IsCancel="True" />
    </Grid>
</Window>
