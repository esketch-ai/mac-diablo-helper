<Window x:Class="DM_Helper.Wpf.Views.PresetShareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="구글 시트 프리셋 공유 센터" Height="620" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBgBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock x:Name="SheetLabel" Text="시트" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="SheetUrlBox" Width="380" TextChanged="OnSheetUrlChanged" />
            </StackPanel>

            <Button Grid.Column="1" x:Name="RefreshButton" Content="새로고침"
                    Style="{StaticResource SecondaryButton}"
                    Margin="6,0,0,0" Click="OnRefreshClick" />
            <Button Grid.Column="2" x:Name="LoadButton" Content="슬롯으로 불러오기"
                    Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" Click="OnLoadClick" />
            <Button Grid.Column="3" x:Name="ShareButton" Content="내 빌드 공유"
                    Style="{StaticResource SecondaryButton}"
                    Margin="6,0,0,0" Click="OnShareClick" />
            <Button Grid.Column="4" x:Name="CopyButton" Content="행 복사"
                    Style="{StaticResource SecondaryButton}"
                    Margin="6,0,0,0" Click="OnCopyClick" />
        </Grid>

        <!-- Filters -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="ClassLabel" Text="직업" Margin="0,0,6,0" />
            <ComboBox Grid.Column="1" x:Name="ClassFilter" Width="180" HorizontalAlignment="Left"
                      SelectionChanged="OnFilterChanged" />

            <TextBlock Grid.Column="2" x:Name="SeasonLabel" Text="시즌" Margin="12,0,6,0" />
            <ComboBox Grid.Column="3" x:Name="SeasonFilter" Width="180" HorizontalAlignment="Left"
                      SelectionChanged="OnFilterChanged" />
        </Grid>

        <!-- Results -->
        <Border Grid.Row="2" Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DataGrid x:Name="PresetGrid" Grid.Row="0" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False"
                          GridLinesVisibility="Horizontal" RowHeight="26"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          BorderThickness="0" Background="Transparent"
                          RowBackground="Transparent" AlternatingRowBackground="#00000008">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="작성자" Binding="{Binding Author}" Width="110" />
                        <DataGridTextColumn Header="직업" Binding="{Binding Class}" Width="90" />
                        <DataGridTextColumn Header="빌드" Binding="{Binding Build}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="EmptyLabel" Grid.Row="1" Text="표시할 프리셋이 없습니다."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource SubtleTextBrush}" Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusLabel" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CloseButton" Content="닫기"
                        Style="{StaticResource SecondaryButton}" IsCancel="True"
                        Click="OnCloseClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
