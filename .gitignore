# fastlane
#
# It is recommended to not store the screenshots in the git repo. Instead, use fastlane to re-generate the 
# screenshots whenever they are needed.
# For more information about the recommended setup visit:
# https://github.com/fastlane/fastlane/blob/master/docs/Gitignore.md

fastlane/report.xml
fastlane/screenshots

# .NET (Windows 11 port)
bin/
obj/
*.user
.vs/
publish/

# Release artifacts
#
# Binaries belong on GitHub Releases, not in git history. Committing the 64MB Windows exe
# would bloat every future clone for no benefit. CI output and locally built packages are
# ignored for the same reason.
dm_helper-*.zip
dm_helper-*.zip.sha256
DM_Helper-*-macos.zip
DM_Helper-*-macos.zip.sha256
DM_Helper-*-windows-x64.zip
DM_Helper-*-windows-x64.zip.sha256
out/

# macOS
.DS_Store
